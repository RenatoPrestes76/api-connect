# Database
# docker-compose.yml's postgres service maps to host port 5433, not the
# Postgres default 5432 — on a machine that also runs a native/other
# Postgres install bound to 5432, Prisma's host-side connections would
# silently land on that unrelated instance instead of this project's
# container. Match docker-compose.yml's ports mapping if you change this.
DATABASE_URL=postgresql://user:password@localhost:5433/seltriva_connect

# API
API_PORT=3001
API_SECRET_KEY=your_secret_key_here
API_LOG_LEVEL=debug

# Cloud
CLOUD_PORT=3000
CLOUD_API_URL=http://localhost:3001

# Studio
STUDIO_PORT=3002

# Agent
AGENT_PORT=3003

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Redis
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
