{
  "name": "seltriva-connect",
  "version": "0.1.0",
  "description": "Enterprise API platform built for scale, security, and reliability",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=\"!./apps/docs\" --filter=\"!./apps/developer-portal\"",
    "build:all": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:cloud": "turbo run dev --filter=\"./apps/cloud\"",
    "dev:api": "turbo run dev --filter=\"./apps/api\"",
    "dev:studio": "turbo run dev --filter=\"./apps/studio\"",
    "dev:agent": "turbo run dev --filter=\"./apps/agent\"",
    "lint": "turbo run lint --filter=\"!./apps/docs\" --filter=\"!./apps/developer-portal\"",
    "lint:fix": "turbo run lint --env-mode=loose -- --fix",
    "format": "prettier --write '**/*.{ts,tsx,json,md,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,md,yml,yaml}'",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo clean && pnpm -r clean",
    "db:push": "turbo run db:push --filter=\"./packages/database\"",
    "db:generate": "turbo run db:generate --filter=\"./packages/database\"",
    "validate": "pnpm lint && pnpm type-check && pnpm format:check",
    "prepare": "husky",
    "env:validate": "node scripts/validate-env.js",
    "readiness:check": "node scripts/atlas-production-readiness.mjs",
    "production:preflight": "node scripts/production/preflight.mjs",
    "production:deploy": "node scripts/production/deploy.mjs",
    "production:migrate": "node scripts/production/migrate.mjs",
    "production:verify": "node scripts/production/verify.mjs",
    "production:client-zero": "node scripts/production/client-zero.mjs",
    "production:rollback": "node scripts/production/rollback.mjs",
    "production:domain": "node scripts/production/domain.mjs",
    "production:dry-run": "node scripts/production/dry-run.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.3.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-turbo": "^2.0.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.2.5",
    "turbo": "^2.0.11",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.4.5",
      "happy-dom@<15.10.2": ">=15.10.2",
      "esbuild@<=0.24.2": ">=0.25.0",
      "cookie@<0.7.0": ">=0.7.0",
      "happy-dom@<20.0.0": ">=20.0.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "happy-dom@<20.8.9": ">=20.8.9",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "@opentelemetry/sdk-node@<0.217.0": ">=0.217.0",
      "tmp@<0.2.6": ">=0.2.6",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "protobufjs@>=7.5.0 <=7.6.4": ">=7.6.5",
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "sharp@<0.35.0": ">=0.35.0",
      "next@>=13.0.0 <15.5.21": ">=15.5.21 <16.0.0",
      "next@>=14.1.1 <15.5.21": ">=15.5.21 <16.0.0",
      "next@>=12.0.0 <15.5.21": ">=15.5.21 <16.0.0",
      "next@>=15.5.0 <15.5.21": ">=15.5.21 <16.0.0",
      "postcss@<=8.5.11": ">=8.5.12",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "postcss@<=8.5.22": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "tar@<=7.5.20": ">=7.5.21",
      "browserslist@<=4.28.6": ">=4.28.7",
      "@opentelemetry/core@<2.8.0": ">=2.8.0",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.1.2 <3.1.6": ">=3.1.6",
      "mysql2@<=3.23.0": ">=3.23.1",
      "fast-uri@>=3.0.0 <3.1.3": ">=3.1.3"
    }
  }
}
