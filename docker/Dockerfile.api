FROM node:24-alpine AS base
# openssl (not just the bundled libssl.so.3) is required for Prisma's runtime
# engine-selection to correctly detect OpenSSL 3.x — without the CLI/dev
# package, it fails detection and falls back to loading the wrong
# (openssl-1.1.x) query engine binary, which then fails to load at all.
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g pnpm@9.0.0
WORKDIR /app

# A single stage does the full workspace install + build. A separate
# "install only apps/api/package.json" stage doesn't work with pnpm
# workspaces — pnpm needs every workspace member's package.json (copied in
# via `COPY . .` below) to resolve anything.
FROM base AS build
COPY pnpm-lock.yaml .
COPY package.json .
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter=@seltriva/database run db:generate
RUN pnpm build --filter=./apps/api

# ATLAS 46.31 — this stage used to COPY the build stage's node_modules
# directories directly into the final image (root node_modules +
# apps/api/node_modules) on the theory that pnpm's per-package symlinks
# (e.g. apps/api/node_modules/dotenv -> ../../node_modules/.pnpm/dotenv@.../
# node_modules/dotenv) would keep resolving correctly as long as both sides
# preserved the same relative depth. In practice the shipped image crashed
# immediately on boot: `Error [ERR_MODULE_NOT_FOUND]: Cannot find package
# 'dotenv' imported from /app/apps/api/dist/index.js` — confirmed directly,
# a real container built from this file never actually started. `pnpm
# deploy` is pnpm's own purpose-built solution for exactly this: it
# materializes one workspace package's production dependencies into a
# self-contained directory with a real (non-symlinked) node_modules, so
# there's no virtual-store indirection left to break across a COPY
# --from=. `pnpm prune --prod` (tried previously, per the removed comment
# above) attacks the same problem from the wrong end — pruning the shared
# store in place, rather than deploying a clean, standalone copy.
RUN pnpm --filter=@seltriva/api deploy --prod /app/deploy
# `pnpm deploy` materializes its own, separate copy of @prisma/client — a
# real directory, not a symlink into the workspace's shared store — so the
# engine `db:generate` (run above, against the *shared* store) wrote into
# is not the copy this deployed output actually uses. @prisma/client's own
# postinstall does try to run again during `pnpm deploy`'s install, but it
# can't find prisma/schema.prisma from inside the isolated deploy
# directory (confirmed directly: `prisma:warn We could not find your
# Prisma schema in the default locations`), so it silently no-ops and the
# deployed client is left ungenerated — confirmed directly too: a real
# container built without this fix crashes on the first Prisma query with
# `@prisma/client did not initialize yet`. Prisma resolves which
# `@prisma/client` install to generate into by walking up from the schema
# file's own directory — copying the schema inside /app/deploy first (and
# running from there) makes that walk land on the deployed copy, not the
# shared workspace store `db:generate` already populated.
RUN mkdir -p /app/deploy/prisma && \
    cp /app/packages/database/prisma/schema.prisma /app/deploy/prisma/schema.prisma
# `npx prisma` here (rather than the workspace's own pinned binary) floats
# to whatever `prisma` CLI version npx resolves independently — confirmed
# directly: this workspace has *two* `prisma`/`@prisma/client` major
# versions coexisting (packages/database pins 5.22.0; another app in this
# monorepo pins 6.19.3), and npx picked the mismatched one, producing a
# client generated for a query-engine WASM file that pairing doesn't ship.
# packages/database/node_modules/.bin/prisma is the exact CLI version
# packages/database's own lockfile entry pins (the same one `db:generate`
# above already used successfully) — unambiguous, no floating resolution.
RUN cd /app/deploy && /app/packages/database/node_modules/.bin/prisma generate --schema=./prisma/schema.prisma

FROM base
COPY --from=build /app/deploy/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist

WORKDIR /app/apps/api
EXPOSE 3001
# Render's healthCheckPath (render.yaml) is a platform-level check; this is
# the container-level equivalent so the image is self-sufficient if it's
# ever run under plain Docker/Compose/K8s instead. Reuses the existing
# /health endpoint — no new endpoint, no extra package (node's built-in
# fetch is available on node:24).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://localhost:3001/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "dist/index.js"]
