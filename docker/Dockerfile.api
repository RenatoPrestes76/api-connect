FROM node:24-alpine AS base
# openssl (not just the bundled libssl.so.3) is required for Prisma's runtime
# engine-selection to correctly detect OpenSSL 3.x — without the CLI/dev
# package, it fails detection and falls back to loading the wrong
# (openssl-1.1.x) query engine binary, which then fails to load at all.
RUN apk add --no-cache libc6-compat openssl
RUN npm install -g pnpm@9.0.0
WORKDIR /app

# A single stage does the full workspace install + build. A separate
# "install only apps/api/package.json" stage doesn't work with pnpm
# workspaces — pnpm needs every workspace member's package.json (copied in
# via `COPY . .` below) to resolve anything. `pnpm prune --prod` was tried
# to slim the final node_modules but incorrectly strips real runtime deps
# (e.g. dotenv) in this workspace's virtual-store layout — correctness over
# image size, so the full install ships as-is.
FROM base AS build
COPY pnpm-lock.yaml .
COPY package.json .
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter=@seltriva/database run db:generate
RUN pnpm build --filter=./apps/api

FROM base
# pnpm's per-package node_modules (e.g. apps/api/node_modules/dotenv) are symlinks
# with RELATIVE targets into the root node_modules/.pnpm virtual store (e.g.
# ../../node_modules/.pnpm/dotenv@.../node_modules/dotenv). Flattening dist to
# /app/dist while only copying the root node_modules breaks those symlinks —
# apps/api's own node_modules must be copied too, at its original relative depth.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages ./packages

WORKDIR /app/apps/api
EXPOSE 3001
# Render's healthCheckPath (render.yaml) is a platform-level check; this is
# the container-level equivalent so the image is self-sufficient if it's
# ever run under plain Docker/Compose/K8s instead. Reuses the existing
# /health endpoint — no new endpoint, no extra package (node's built-in
# fetch is available on node:24).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://localhost:3001/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "dist/index.js"]
