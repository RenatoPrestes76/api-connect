# Copy to .env for local development. In production (Render), these are set
# as environment variables in the service dashboard — see render.yaml.

NODE_ENV=development
API_PORT=3001

# Required — the process refuses to start without these two (see
# packages/config/src/index.ts validateEnv()).
API_SECRET_KEY=dev_secret_key_local
DATABASE_URL=postgresql://seltriva:seltriva_dev_password@localhost:5433/seltriva_connect

REDIS_URL=redis://localhost:6379

# Optional — see individual modules for defaults when unset.
LOG_LEVEL=info
# Comma-separated allowlist; unset (or '*') keeps every origin allowed, which
# is fine for local dev but must be a real allowlist in production. Once
# atlasappruntime.com.br is registered (see docs/ATLAS-PRODUCTION-DOMAIN.md),
# production (Render) should set:
# CORS_ALLOWED_ORIGINS=https://app.atlasappruntime.com.br,https://admin.atlasappruntime.com.br
CORS_ALLOWED_ORIGINS=*
ATLAS_MASTER_KEY=
SEED_ADMIN_EMAIL=admin@atlasconnect.com.br
# Set your own bootstrap password here — do not reuse whatever is in this
# file across environments. mustChangePassword=true forces a real rotation
# on first login regardless, but the bootstrap value itself shouldn't be a
# value anyone can find in source control.
SEED_ADMIN_PASSWORD=change_me_on_first_boot
