# Copy to .env for local development. In production (Render), these are set
# as environment variables in the service dashboard — see render.yaml.

NODE_ENV=development
API_PORT=3001

# Required — the process refuses to start without these two (see
# packages/config/src/index.ts validateEnv()).
API_SECRET_KEY=dev_secret_key_local
DATABASE_URL=postgresql://seltriva:seltriva_dev_password@localhost:5433/seltriva_connect

# Provisioned in docker-compose.yml, but no application code currently reads
# it (ATLAS 46.31 finding — kept here as-is since it's real infrastructure,
# not removed; not a required var).
REDIS_URL=redis://localhost:6379

# Optional — see individual modules for defaults when unset.
LOG_LEVEL=info
# Comma-separated allowlist; unset (or '*') keeps every origin allowed, which
# is fine for local dev but must be a real allowlist in production. Once
# atlasappruntime.com.br is registered (see docs/ATLAS-PRODUCTION-DOMAIN.md),
# production (Render) should set:
# CORS_ALLOWED_ORIGINS=https://app.atlasappruntime.com.br,https://admin.atlasappruntime.com.br
CORS_ALLOWED_ORIGINS=*
ATLAS_MASTER_KEY=
SEED_ADMIN_EMAIL=admin@atlasconnect.com.br
# Set your own bootstrap password here — do not reuse whatever is in this
# file across environments. mustChangePassword=true forces a real rotation
# on first login regardless, but the bootstrap value itself shouldn't be a
# value anyone can find in source control.
SEED_ADMIN_PASSWORD=change_me_on_first_boot

# ATLAS 46.31 — the rest of services/production-secrets.ts's
# REQUIRED_IN_PRODUCTION list. Each falls back to a hardcoded,
# source-visible dev default when unset outside production (so local/test
# runs need zero setup), but assertProductionSecretsConfigured() refuses to
# boot with NODE_ENV=production if any of these is missing — see that file
# for exactly which module signs/encrypts with which one.
ADMIN_JWT_SECRET=
PORTAL_JWT_SECRET=
RUNTIME_JWT_SECRET=
RUNTIME_CERT_SECRET=
CONNECTOR_PACKAGE_SECRET=
MESSAGE_DELIVERY_SECRET=
SUPABASE_JWT_SECRET=

# Optional — AI Copilot search/generate/explain/diagnose/chat routes
# (routes/v1/copilot/*, routes/v1/workflow-builder/plan.ts). Unset means
# those routes fall back to a deterministic demo response instead of
# calling the real Anthropic API — never required for the core operational
# cycle (provisioning/runtime/discovery/jobs).
ANTHROPIC_API_KEY=
